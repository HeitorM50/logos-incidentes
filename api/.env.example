# Conexão com o Postgres (Supabase, session pooler). Use o driver psycopg.
DATABASE_URL=postgresql+psycopg://usuario:senha@host:5432/postgres

# Segredo para assinar os tokens JWT. Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SEGREDO=troque-este-valor

# Domínios autorizados a chamar a API (separados por vírgula)
CORS_ORIGENS=http://localhost:5173

# Simulação de falha para demonstração (0 = desligado)
SIMULAR_LATENCIA_MS=0
SIMULAR_FALHA_PCT=0
