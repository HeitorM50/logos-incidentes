# Conexão com o Postgres (Supabase, session pooler, porta 5432). Use o driver psycopg.
# O usuário da API tem search_path = logos (ADR 0006).
DATABASE_URL=postgresql+psycopg://logos_api.<ref-do-projeto>:<senha>@aws-1-sa-east-1.pooler.supabase.com:5432/postgres?sslmode=require

# Segredo para assinar os tokens JWT (mínimo 32 caracteres). Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SEGREDO=troque-este-valor

# Domínios autorizados a chamar a API (separados por vírgula)
CORS_ORIGENS=http://localhost:5173

# Simulação de falha para demonstração (0 = desligado)
SIMULAR_LATENCIA_MS=0
SIMULAR_FALHA_PCT=0
