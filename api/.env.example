# Conexão com o Postgres (driver psycopg).
# Local: o Postgres do docker-compose.yml da raiz (`docker compose up -d`).
DATABASE_URL=postgresql+psycopg://logos:logos@localhost:55432/logos
# Produção (Supabase, session pooler; o usuário da API tem search_path = logos, ADR 0006):
# DATABASE_URL=postgresql+psycopg://logos_api.<ref-do-projeto>:<senha>@aws-0-us-east-1.pooler.supabase.com:5432/postgres?sslmode=require

# Segredo para assinar os tokens JWT (mínimo 32 caracteres). Este valor serve só para rodar
# localmente; em produção o Render gera um próprio (render.yaml). Para gerar outro:
# uv run python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SEGREDO=somente-desenvolvimento-local-troque-em-producao

# Domínios autorizados a chamar a API (separados por vírgula)
CORS_ORIGENS=http://localhost:5173

# Simulação de falha para demonstração (0 = desligado)
SIMULAR_LATENCIA_MS=0
SIMULAR_FALHA_PCT=0
